;; -*- mode: lisp -*-

(challenge
 (id            "citytime")
 (name          _("Finish the City track in 4:00"))
 (description   _("Finish 3 laps on the City track\nwith 4 AI karts\nin under 4:00 minutes."))
 (unlock-track  "snowtuxpeak")
 (depend-on     "junglefollow" "starfollow")
 (major         "single")
 (minor         "quickrace")
 (track         "city")
 (difficulty    "hard")
 (laps          3)
 (karts         5)
 (time        240)
)

